<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- focusableInTouchMode stops the selectable log TextView from stealing focus on launch,
         which would open the screen scrolled to the bottom. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/status_disconnected"
            android:textAppearance="?attr/textAppearanceSubtitle1" />

        <!-- Watch: one shared IP field for both pairing and connecting, plus pairing tucked
             behind a disclosure toggle since it is only needed once per watch. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/SectionCard">

            <LinearLayout style="@style/SectionBody">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/SectionTitle"
                    android:text="@string/card_watch_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/setupHelpToggle"
                    style="@style/ToggleText"
                    android:text="@string/action_setup_help" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/setupHelpBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="@string/prepare_instructions"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:visibility="gone" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:hint="@string/hint_watch_host">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/watchHost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Field"
                    android:hint="@string/hint_connect_port">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/connectPort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/connectButton"
                    style="@style/Action"
                    android:text="@string/action_connect" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/autoConnectButton"
                    style="@style/ActionOutlined"
                    android:text="@string/action_auto_connect" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/disconnectButton"
                    style="@style/ActionOutlined"
                    android:text="@string/action_disconnect" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pairingToggle"
                    style="@style/ToggleText"
                    android:text="@string/action_pairing_toggle" />

                <LinearLayout
                    android:id="@+id/pairingGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field"
                        android:hint="@string/hint_pair_port">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/pairPort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field"
                        android:hint="@string/hint_pair_code">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/pairCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pairButton"
                        style="@style/Action"
                        android:text="@string/action_pair" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Install: the primary action. Enabled as soon as an APK is chosen — it reconnects on
             its own if the link is down, rather than staying disabled with no explanation. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/SectionCard">

            <LinearLayout style="@style/SectionBody">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/SectionTitle"
                    android:text="@string/card_install_title" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/apkLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="@string/no_apk_selected"
                    android:textAppearance="?attr/textAppearanceBody2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chooseApkButton"
                    style="@style/ActionOutlined"
                    android:text="@string/action_choose_apk" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/installHint"
                    style="@style/Hint"
                    android:text="@string/install_hint_no_apk" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/installButton"
                    style="@style/Action"
                    android:text="@string/action_install" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tools: secondary actions, collapsed by default. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/SectionCard">

            <LinearLayout style="@style/SectionBody">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toolsToggle"
                    style="@style/ToggleText"
                    android:text="@string/card_tools_title" />

                <LinearLayout
                    android:id="@+id/toolsGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/listPackagesButton"
                        style="@style/ActionOutlined"
                        android:text="@string/action_list_packages" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Field"
                        android:layout_marginTop="12dp"
                        android:hint="@string/hint_uninstall_package">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/uninstallPackage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/uninstallButton"
                        style="@style/ActionOutlined"
                        android:text="@string/action_uninstall" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/SectionCard">

            <LinearLayout style="@style/SectionBody">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/SectionTitle"
                    android:text="@string/section_log" />

                <ScrollView
                    android:id="@+id/logScroll"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:fillViewport="true">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/logView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textIsSelectable="true" />
                </ScrollView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clearLogButton"
                    style="@style/ActionOutlined"
                    android:text="@string/action_clear_log" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="invisible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
